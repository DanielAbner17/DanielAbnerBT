{
  "name": "astro-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plantilla estática de Astro, React, Tailwind CSS y TypeScript.",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run lint && npm run format:check && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
