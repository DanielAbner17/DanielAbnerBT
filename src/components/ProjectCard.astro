---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="work-card" aria-labelledby={`project-${project.slug}`}>
  <a
    class="work-image-link"
    href={`/proyectos/${project.slug}/`}
    aria-label={`Ver caso: ${project.name}`}
  >
    <Image
      src={project.image.src}
      alt={project.image.alt}
      widths={[480, 800, 1111]}
      sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1050px) calc(50vw - 32px), 570px"
      format="webp"
      quality={85}
      loading="lazy"
    />
    <span class="work-image-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
  <div class="work-body">
    <p class="work-context">
      <span aria-hidden="true">{project.number} /</span> {project.context}
    </p>
    <h3 id={`project-${project.slug}`}>{project.name}</h3>
    <p class="work-focus">{project.focus}</p>
    <p class="work-description">{project.description}</p>
    <ul class="tags" aria-label={`Tecnologías de ${project.name}`}>
      {project.technologies.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    {project.technologyScope && (
      <p class="work-scope">{project.technologyScope}</p>
    )}
    <div class="work-links">
      <a
        class="text-link"
        href={`/proyectos/${project.slug}/`}
        aria-label={`Ver mi participación en ${project.name}`}
      >
        Ver mi participación <span aria-hidden="true">→</span>
      </a>
      <a
        class="text-link"
        href={project.siteUrl}
        target="_blank"
        rel="noreferrer"
        aria-label={`Visitar ${project.slug === 'grupo-mexico' ? 'Ciudadela Urban Village' : project.name} (abre en otra pestaña)`}
      >
        Visitar sitio <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>
