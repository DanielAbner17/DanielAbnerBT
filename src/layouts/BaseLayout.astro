---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import portrait from '../assets/abner-tovar.jpg';
import { profile } from '../data/portfolio';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
}

const {
  title,
  description = 'Soy Abner Tovar, desarrollador frontend en México. Defino soluciones, construyo interfaces e integro servicios para llevarlas a producción.',
  noindex = false,
  socialImage = portrait,
  socialImageAlt = 'Abner Tovar, desarrollador frontend',
} = Astro.props;
const canonical =
  Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site
  ? new URL(socialImage.src, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#141715" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Abner Tovar" />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta
      name="twitter:card"
      content={
        socialImage.width > socialImage.height
          ? 'summary_large_image'
          : 'summary'
      }
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido" class="skip-link">
      Saltar al contenido
    </a>
    <Navigation />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
