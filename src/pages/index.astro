---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from '../components/ProjectGallery';
import { profile, experience } from '../data/portfolio';
const skills = [
  {
    title: 'Interfaces & experiencias',
    detail:
      'Componentes reutilizables e interfaces que se adaptan a cada pantalla.',
    items: [
      'React',
      'Next.js',
      'Astro',
      'TypeScript',
      'JavaScript',
      'HTML & CSS',
    ],
  },
  {
    title: 'Diseño que se implementa',
    detail: 'Del detalle visual a una experiencia consistente y accesible.',
    items: [
      'Tailwind CSS',
      'Styled Components',
      'Responsive design',
      'Lighthouse',
      'Core Web Vitals',
    ],
  },
  {
    title: 'Del código a producción',
    detail: 'Servicios conectados y entregas que se pueden mantener.',
    items: [
      'Node.js',
      'GraphQL',
      'Firebase',
      'WordPress',
      'Git & GitHub',
      'Vercel',
    ],
  },
];
---

<BaseLayout
  title="Daniel Balderas — Frontend Developer"
  description="Desarrollador frontend en México. Creo sitios y aplicaciones con React, TypeScript y Astro, con foco en rendimiento, componentes reutilizables y experiencias claras."
>
  <section class="shell hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="availability">
        <span></span> Disponible para trabajo remoto
      </p>
      <p class="hero-intro">
        Hola, soy Daniel Balderas <span aria-hidden="true">↗</span>
      </p>
      <h1 id="hero-title">
        Ideas claras.
        <br />
        Interfaces <span>que conectan.</span>
      </h1>
      <p class="hero-description">
        Desarrollador <strong>frontend</strong>. Transformo ideas en
        experiencias web intuitivas, rápidas y hechas para las personas.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#proyectos">
          Explorar proyectos <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={profile.cv} download>
          Descargar CV <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="hero-location">
        <span aria-hidden="true">◎</span> Montemorelos, Nuevo León, México{' '}
        <span class="location-line"></span> Abierto al mundo
      </p>
    </div>
    <div
      class="hero-art"
      aria-label="Ilustración de una interfaz: Daniel Balderas, desarrollador frontend"
    >
      <div class="art-grid"></div>
      <span class="art-coordinate">25°11′ N / 99°49′ W</span>
      <div class="identity-card">
        <div class="identity-top">
          <span>DESARROLLADOR FRONTEND</span>
          <span>↗</span>
        </div>
        <div class="monogram">
          d<span>b</span>
          <i>.</i>
        </div>
        <div class="identity-bottom">
          <b>Daniel Balderas</b>
          <span>Construyendo para la web.</span>
        </div>
      </div>
      <span class="floating-tag tag-react">
        <span>✳</span> React
      </span>
      <span class="floating-tag tag-ts">
        <b>TS</b> TypeScript
      </span>
      <span class="floating-tag tag-astro">
        <b>A</b> Astro
      </span>
      <div class="art-caption">
        <span class="code-mark">&lt;/&gt;</span>
        <span>
          Un poco de lógica.
          <br />
          <b>Mucho de intención.</b>
        </span>
        <span aria-hidden="true">✳</span>
      </div>
    </div>
  </section>
  <div class="stack-strip">
    <div class="shell">
      <span>MI KIT PARA CREAR</span>
      <span>React</span>
      <span class="strip-star">✳</span>
      <span>TypeScript</span>
      <span class="strip-star">✳</span>
      <span>Astro</span>
      <span class="strip-star">✳</span>
      <span>Tailwind CSS</span>
      <span class="strip-star">✳</span>
      <span>Firebase</span>
    </div>
  </div>
  <section
    id="experiencia"
    class="shell section"
    aria-labelledby="experience-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / EL RECORRIDO</p>
        <h2 id="experience-title">
          Experiencia que
          <br />
          se convierte en <span>soluciones.</span>
        </h2>
      </div>
      <p>
        De sitios corporativos a plataformas internas.
        <br />
        Siempre con las personas en el centro.
      </p>
    </div>
    <div class="experience-list">
      {experience.map((job, index) => (
        <article class="experience-row">
          <div class="experience-date">
            <span
              class:list={['timeline-dot', { 'dot-current': index === 0 }]}
            ></span>
            <span>{job.period}</span>
            <p>{job.company}</p>
          </div>
          <div class="experience-content">
            <h3>{job.role}</h3>
            <p class="job-description">{job.description}</p>
            <ul class="job-points">
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <ul class="tags" aria-label="Tecnologías">
              {job.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
          <span class="row-index" aria-hidden="true">
            0{index + 1}
          </span>
        </article>
      ))}
    </div>
  </section>
  <section
    id="proyectos"
    class="shell section projects-section"
    aria-labelledby="projects-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / IDEAS EN PANTALLA</p>
        <h2 id="projects-title">
          Código con <span>propósito.</span>
        </h2>
      </div>
      <p>
        Una muestra de lo que se puede construir.
        <br />
        Este espacio pronto tendrá mis proyectos reales.
      </p>
    </div>
    <ProjectGallery client:load />
    <noscript>
      <p class="noscript-note">
        Los conceptos se muestran completos. Activa JavaScript para utilizar los
        filtros.
      </p>
    </noscript>
  </section>
  <section
    id="sobre-mi"
    class="shell section about-section"
    aria-labelledby="about-title"
  >
    <div class="about-visual">
      <p class="eyebrow">UN POCO MÁS HUMANO</p>
      <div class="about-symbol" aria-hidden="true">
        ✳
      </div>
      <p>
        Ingeniería para resolver.
        <br />
        <span>Curiosidad para crear.</span>
      </p>
      <div class="about-coordinate">
        MÉXICO <span>→</span> DONDE ESTÉ EL RETO
      </div>
    </div>
    <div class="about-copy">
      <p class="eyebrow">03 / DETRÁS DEL CÓDIGO</p>
      <h2 id="about-title">
        Soy Daniel.
        <br />
        <span>Me gusta construir.</span>
      </h2>
      <p>
        Soy ingeniero en Sistemas Computacionales por la Universidad de
        Montemorelos. He trabajado en experiencias para educación, salud,
        comercio electrónico y sitios corporativos.
      </p>
      <p>
        Disfruto convertir necesidades complejas en interfaces claras. Me
        involucro desde la definición de requisitos hasta el despliegue:
        componentes que se reutilizan, rendimiento que se cuida y detalles que
        hacen más fácil usar un producto.
      </p>
      <p>
        También he coordinado proyectos y equipos en construcción residencial.
        Esa experiencia me enseñó a planear, comunicar y llevar las ideas hasta
        la entrega.
      </p>
      <div class="about-facts">
        <span>
          Español <b>Nativo</b>
        </span>
        <span>
          Inglés <b>Intermedio</b>
        </span>
        <span>
          Modalidad <b>Remoto</b>
        </span>
      </div>
      <a class="text-link" href={profile.cv} download>
        Mi trayectoria completa <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="shell section skills-section" aria-labelledby="skills-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / HERRAMIENTAS & CRITERIO</p>
        <h2 id="skills-title">
          Mi stack, <span>con intención.</span>
        </h2>
      </div>
      <p>La herramienta adecuada para cada problema.</p>
    </div>
    <div class="skills-grid">
      {skills.map((group, i) => (
        <article>
          <span class="skill-number">
            0{i + 1} <span aria-hidden="true">↗</span>
          </span>
          <h3>{group.title}</h3>
          <p>{group.detail}</p>
          <ul class="tags">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <section
    id="contacto"
    class="shell contact-section"
    aria-labelledby="contact-title"
  >
    <div class="contact-top">
      <p class="eyebrow">05 / LA SIGUIENTE IDEA</p>
      <span aria-hidden="true">↗</span>
    </div>
    <p>¿Un proyecto en mente? ¿Un lugar en tu equipo?</p>
    <h2 id="contact-title">
      Hagamos que <em>suceda.</em>
    </h2>
    <div class="contact-bottom">
      <a class="contact-email" href={`mailto:${profile.email}`}>
        {profile.email} <span aria-hidden="true">↗</span>
      </a>
      <div>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">
          LinkedIn ↗
        </a>
        <a href={profile.github} target="_blank" rel="noreferrer">
          GitHub ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
