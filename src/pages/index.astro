---
import { Image } from 'astro:assets';
import portrait from '../assets/daniel-balderas.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from '../components/ProjectGallery';
import { profile, experience, contributions } from '../data/portfolio';

const skills = [
  {
    title: 'Frontend',
    detail:
      'Construyo interfaces y organizo componentes que se pueden reutilizar.',
    items: [
      'React',
      'Next.js',
      'Astro',
      'TypeScript',
      'JavaScript',
      'HTML5 & CSS3',
    ],
  },
  {
    title: 'Interfaces',
    detail:
      'Adapto la experiencia visual a cada pantalla y necesidad de contenido.',
    items: [
      'Tailwind CSS',
      'Styled Components',
      'Bootstrap',
      'Diseño responsive',
    ],
  },
  {
    title: 'Servicios & contenido',
    detail: 'Integro datos, autenticación y herramientas de gestión.',
    items: [
      'Node.js',
      'GraphQL',
      'Firebase',
      'WordPress',
      'PHP',
      'Google Maps API',
      'GA4',
    ],
  },
  {
    title: 'Entrega & calidad',
    detail:
      'Valido, documento y doy seguimiento a los cambios hasta producción.',
    items: [
      'Git & GitHub',
      'Vercel',
      'Lighthouse',
      'Core Web Vitals',
      'QA manual',
      'Scrum / Kanban',
      'Trello',
    ],
  },
];
---

<BaseLayout
  title="Daniel Balderas — Frontend Developer"
  description="Soy Daniel Balderas, desarrollador frontend en México. Defino soluciones, construyo interfaces con React, TypeScript y Astro e integro servicios para llevarlas a producción."
>
  <section class="shell hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="availability">
        <span aria-hidden="true"></span> Disponible para trabajo remoto
      </p>
      <p class="hero-intro">
        Hola, soy <strong>Daniel Balderas</strong>{' '}
        <span aria-hidden="true">↗</span>
      </p>
      <p class="hero-role">
        Frontend Developer <span aria-hidden="true">/</span> React · TypeScript
        · Astro
      </p>
      <h1 id="hero-title">
        Defino. Construyo.
        <br />
        <span>Llevo a producción.</span>
      </h1>
      <p class="hero-description">
        Asumo el ciclo completo de sitios y aplicaciones web:{' '}
        <strong>
          defino la solución técnica, construyo las interfaces e integro los
          servicios
        </strong>
        . Trabajo con autonomía y comunicación directa con clientes y áreas de
        negocio.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#proyectos">
          Explorar proyectos <span aria-hidden="true">↗</span>
        </a>
        <a class="button-secondary" href={profile.cv} download>
          Descargar CV <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-socials" aria-label="Contacto y perfiles profesionales">
        <a href={`mailto:${profile.email}`}>
          <span aria-hidden="true">✉</span> Escríbeme
        </a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={profile.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero-location">
        <span aria-hidden="true">◎</span> Montemorelos, Nuevo León, México
      </p>
    </div>
    <figure class="portrait-composition">
      <div class="portrait-halo" aria-hidden="true"></div>
      <span class="portrait-coordinate" aria-hidden="true">
        DESDE MÉXICO, PARA LA WEB
      </span>
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Daniel Abner Balderas Tovar, desarrollador frontend"
          width={460}
          height={460}
          widths={[320, 460]}
          sizes="(max-width: 760px) 320px, 380px"
          format="webp"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
        <span class="portrait-corner corner-top" aria-hidden="true"></span>
        <span class="portrait-corner corner-bottom" aria-hidden="true"></span>
      </div>
      <figcaption class="portrait-caption">
        <span class="portrait-caption-icon" aria-hidden="true">
          &lt;/&gt;
        </span>
        <div>
          <b>Daniel Abner Balderas Tovar</b>
          <span>Ingeniero en Sistemas Computacionales</span>
        </div>
        <span class="portrait-caption-star" aria-hidden="true">
          ✳
        </span>
      </figcaption>
      <span class="portrait-note" aria-hidden="true">
        Del requerimiento al lanzamiento. <span>↗</span>
      </span>
    </figure>
  </section>

  <div class="stack-strip" aria-label="Tecnologías principales">
    <div class="shell">
      <span>CON QUÉ CONSTRUYO</span>
      <span>React</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>TypeScript</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>Astro</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>Tailwind CSS</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>Firebase</span>
    </div>
  </div>

  <section
    class="shell section contributions-section"
    aria-labelledby="contributions-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / APORTACIONES</p>
        <h2 id="contributions-title">
          Lo que he <span>construido.</span>
        </h2>
      </div>
      <p>
        Soluciones concretas.
        <br />
        Decisiones que facilitan el trabajo.
      </p>
    </div>
    <div class="contributions-grid">
      {contributions.map((item) => (
        <article class="contribution-card">
          <p class="contribution-label">{item.label}</p>
          <p class="contribution-figure">{item.figure}</p>
          <h3>{item.title}</h3>
          <p class="contribution-description">{item.description}</p>
          <p class="contribution-context">{item.context}</p>
        </article>
      ))}
    </div>
  </section>

  <section
    id="experiencia"
    class="shell section experience-section"
    aria-labelledby="experience-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / EL RECORRIDO</p>
        <h2 id="experience-title">
          De los requerimientos
          <br />a <span>la entrega.</span>
        </h2>
      </div>
      <p>
        Sitios corporativos, educación y salud.
        <br />
        Así he asumido cada proyecto.
      </p>
    </div>
    <div class="experience-list">
      {experience.map((job, index) => (
        <article class="experience-row">
          <div class="experience-date">
            <span
              class:list={['timeline-dot', { 'dot-highlight': index === 0 }]}
              aria-hidden="true"
            ></span>
            <span>{job.period}</span>
            <p>{job.company}</p>
          </div>
          <div class="experience-content">
            <h3>{job.role}</h3>
            <p class="job-description">{job.description}</p>
            <ul class="job-points">
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <ul class="tags" aria-label="Tecnologías">
              {job.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
          <span class="row-index" aria-hidden="true">
            0{index + 1}
          </span>
        </article>
      ))}
    </div>
  </section>

  <section
    id="proyectos"
    class="shell section projects-section"
    aria-labelledby="projects-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / IDEAS EN PANTALLA</p>
        <h2 id="projects-title">
          Un espacio para <span>explorar.</span>
        </h2>
      </div>
      <p>
        Conceptos de interfaz, por ahora.
        <br />
        Mis casos reales llegarán a este espacio.
      </p>
    </div>
    <ProjectGallery client:load />
    <noscript>
      <p class="noscript-note">
        Los conceptos se muestran completos. Activa JavaScript para utilizar los
        filtros.
      </p>
    </noscript>
  </section>

  <section
    id="sobre-mi"
    class="shell section about-section"
    aria-labelledby="about-title"
  >
    <div class="about-copy">
      <p class="eyebrow">04 / DETRÁS DEL CÓDIGO</p>
      <h2 id="about-title">
        Me gusta construir.
        <br />
        <span>Y llevarlo hasta el final.</span>
      </h2>
      <p>
        Soy <strong>Daniel Abner Balderas Tovar</strong>, ingeniero en Sistemas
        Computacionales por la Universidad de Montemorelos. He desarrollado
        soluciones para comercio electrónico, educación, salud y sitios
        corporativos.
      </p>
      <p>
        Mi trabajo empieza al entender qué necesita resolver un proyecto. Defino
        el alcance técnico, construyo la interfaz y conecto los servicios
        necesarios, con comunicación directa con quienes van a utilizar la
        solución.
      </p>
      <p>
        Además del desarrollo web, he coordinado proyectos residenciales.
        Organizar prioridades, aclarar necesidades y dar seguimiento hasta la
        entrega son prácticas que también llevo a mi trabajo como frontend.
      </p>
      <div class="about-facts">
        <span>
          Español <b>Nativo</b>
        </span>
        <span>
          Inglés <b>Intermedio</b>
        </span>
        <span>
          Disponibilidad <b>Remoto · Tiempo completo</b>
        </span>
      </div>
      <a class="text-link" href={profile.cv} download>
        Ver mi trayectoria completa <span aria-hidden="true">↗</span>
      </a>
    </div>
    <aside class="perspective-card" aria-labelledby="perspective-title">
      <div class="perspective-top">
        <span class="eyebrow">OTRA PERSPECTIVA</span>
        <span aria-hidden="true">✳</span>
      </div>
      <h3 id="perspective-title">
        Planear. Coordinar.
        <br />
        <em>Entregar.</em>
      </h3>
      <p class="perspective-intro">
        Experiencia que complementa mi forma de trabajar.
      </p>
      <div class="additional-job">
        <span>FEB 2026 — ACTUALIDAD</span>
        <h4>Supervisor de obra residencial</h4>
        <p>Proyecto privado · Montemorelos, México</p>
        <p>
          Coordino trabajos y avances de una ampliación residencial. Verifico la
          ejecución conforme a planos y doy seguimiento a definiciones con la
          dirección arquitectónica.
        </p>
      </div>
      <div class="additional-job">
        <span>JUL 2019 — DIC 2021</span>
        <h4>Gerente de proyectos</h4>
        <p>DFW Corp · Dallas, Texas</p>
        <p>
          Dirigí proyectos residenciales desde la planeación y presupuestación
          hasta la entrega, coordinando equipos, alcance y comunicación con
          clientes y especialistas.
        </p>
      </div>
    </aside>
  </section>

  <section class="shell section skills-section" aria-labelledby="skills-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">05 / HERRAMIENTAS & CRITERIO</p>
        <h2 id="skills-title">
          Cada herramienta, <span>en su lugar.</span>
        </h2>
      </div>
      <p>
        Las tecnologías que uso
        <br />a lo largo de una solución.
      </p>
    </div>
    <div class="skills-grid">
      {skills.map((group, i) => (
        <article>
          <span class="skill-number">
            0{i + 1} <span aria-hidden="true">↗</span>
          </span>
          <h3>{group.title}</h3>
          <p>{group.detail}</p>
          <ul class="tags">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section
    id="contacto"
    class="shell contact-section"
    aria-labelledby="contact-title"
  >
    <div class="contact-top">
      <p class="eyebrow">06 / LA SIGUIENTE CONVERSACIÓN</p>
      <span aria-hidden="true">↗</span>
    </div>
    <p>¿Buscas apoyo en un proyecto o un frontend para tu equipo?</p>
    <h2 id="contact-title">
      Hablemos de <em>lo que sigue.</em>
    </h2>
    <div class="contact-bottom">
      <a class="contact-email" href={`mailto:${profile.email}`}>
        {profile.email} <span aria-hidden="true">↗</span>
      </a>
      <div>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={profile.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
