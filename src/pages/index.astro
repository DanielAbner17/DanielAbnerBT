---
import { Image } from 'astro:assets';
import portrait from '../assets/abner-tovar.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { captureDate, projects, historicalProject } from '../data/projects';
import { profile, experience } from '../data/portfolio';

const skills = [
  {
    title: 'Frontend',
    detail:
      'Construyo interfaces y organizo componentes que se pueden reutilizar.',
    items: [
      'React',
      'Next.js',
      'Astro',
      'TypeScript',
      'JavaScript',
      'HTML5 & CSS3',
    ],
  },
  {
    title: 'Interfaces',
    detail:
      'Adapto la experiencia visual a cada pantalla y necesidad de contenido.',
    items: [
      'Tailwind CSS',
      'Styled Components',
      'Bootstrap',
      'Diseño responsive',
    ],
  },
  {
    title: 'Servicios y contenido',
    detail: 'Integro datos, autenticación y herramientas de gestión.',
    items: [
      'Node.js',
      'GraphQL',
      'Firebase',
      'WordPress',
      'PHP',
      'Google Maps API',
      'GA4',
    ],
  },
  {
    title: 'Entrega y calidad',
    detail:
      'Valido, documento y doy seguimiento a los cambios hasta producción.',
    items: [
      'Git & GitHub',
      'Vercel',
      'Lighthouse',
      'Core Web Vitals',
      'QA manual',
      'Scrum / Kanban',
      'Trello',
    ],
  },
];
---

<BaseLayout
  title="Abner Tovar | Desarrollador frontend React y Astro"
  description="Soy Abner Tovar, desarrollador frontend con React, TypeScript y Astro. Conoce mis proyectos, mi experiencia y cómo puedo aportar a tu equipo."
>
  <section class="shell hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="availability">
        <span aria-hidden="true"></span> Disponible para trabajo remoto
      </p>
      <p class="hero-intro">
        Hola, soy <strong>Abner Tovar</strong> <span aria-hidden="true">↗</span>
      </p>
      <p class="hero-role">React · TypeScript · Astro</p>
      <h1 id="hero-title">
        Desarrollador
        <br />
        <span>frontend.</span>
      </h1>
      <p class="hero-description">
        Desarrollo sitios corporativos y aplicaciones web.{' '}
        <strong>Defino arquitectura e integro servicios</strong>, con validación
        y comunicación directa con clientes y áreas de negocio.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#proyectos">
          Explorar proyectos <span aria-hidden="true">↗</span>
        </a>
        <a class="button-secondary" href={profile.cv} download>
          Descargar CV <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-socials" aria-label="Contacto y perfiles profesionales">
        <a href={`mailto:${profile.email}`}>
          <span aria-hidden="true">✉</span> Escríbeme
        </a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={profile.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero-location">
        <span aria-hidden="true">◎</span> Montemorelos, Nuevo León, México
      </p>
    </div>
    <figure class="portrait-composition">
      <div class="portrait-halo" aria-hidden="true"></div>
      <span class="portrait-coordinate" aria-hidden="true">
        DESDE MÉXICO, PARA LA WEB
      </span>
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt="Abner Tovar, desarrollador frontend"
          width={460}
          height={460}
          widths={[320, 460]}
          sizes="(max-width: 760px) 320px, 380px"
          format="webp"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
        <span class="portrait-corner corner-top" aria-hidden="true"></span>
        <span class="portrait-corner corner-bottom" aria-hidden="true"></span>
      </div>
      <figcaption class="portrait-caption">
        <span class="portrait-caption-icon" aria-hidden="true">
          &lt;/&gt;
        </span>
        <div>
          <b>Abner Tovar</b>
          <span>Ingeniero en Sistemas Computacionales</span>
        </div>
        <span class="portrait-caption-star" aria-hidden="true">
          ✳
        </span>
      </figcaption>
      <span class="portrait-note" aria-hidden="true">
        Del requerimiento al lanzamiento. <span>↗</span>
      </span>
    </figure>
  </section>

  <div class="stack-strip" aria-label="Tecnologías principales">
    <div class="shell">
      <span>CON QUÉ CONSTRUYO</span>
      <span>React</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>TypeScript</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>Astro</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>Tailwind CSS</span>
      <span class="strip-star" aria-hidden="true">
        ✳
      </span>
      <span>Firebase</span>
    </div>
  </div>

  <section
    id="proyectos"
    class="shell section projects-section"
    aria-labelledby="projects-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / TRABAJO PUBLICADO</p>
        <h2 id="projects-title">
          Proyectos web.
          <br />
          <span>Mi aportación en cada caso.</span>
        </h2>
      </div>
      <p>
        Sitios corporativos, salud y contenido.
        <br /> Desarrollo completo y colaboración.
      </p>
    </div>
    <p class="capture-note">
      Capturas de los sitios públicos actuales · {captureDate}.
    </p>
    <div class="work-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <aside class="historical-work" aria-labelledby="historical-title">
      <div>
        <p class="eyebrow">{historicalProject.context}</p>
        <h3 id="historical-title">
          {historicalProject.name}
          <span aria-hidden="true"> ↗</span>
        </h3>
      </div>
      <div>
        <p>{historicalProject.description}</p>
        <a
          class="text-link"
          href={historicalProject.archiveUrl}
          target="_blank"
          rel="noreferrer"
        >
          Ver archivo de Loro Granada <span aria-hidden="true">↗</span>
        </a>
        <p class="work-scope">
          Archivo del {historicalProject.archiveDate}. Referencia histórica de
          la agencia, actualmente inactiva.
        </p>
      </div>
    </aside>
  </section>

  <section
    id="experiencia"
    class="shell section experience-section"
    aria-labelledby="experience-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / EL RECORRIDO</p>
        <h2 id="experience-title">
          Experiencia en
          <br />
          <span>desarrollo web.</span>
        </h2>
      </div>
      <p>
        Mi trayectoria en empresas
        <br />y proyectos independientes.
      </p>
    </div>
    <div class="experience-list">
      {experience.map((job, index) => (
        <article class="experience-row">
          <div class="experience-date">
            <span
              class:list={['timeline-dot', { 'dot-highlight': index === 0 }]}
              aria-hidden="true"
            ></span>
            <span>{job.period}</span>
            <p>{job.company}</p>
          </div>
          <div class="experience-content">
            <h3>{job.role}</h3>
            <p class="job-description">{job.description}</p>
            <ul class="job-points">
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <ul class="tags" aria-label="Tecnologías">
              {job.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
          <span class="row-index" aria-hidden="true">
            0{index + 1}
          </span>
        </article>
      ))}
    </div>
  </section>

  <section
    id="sobre-mi"
    class="shell section about-section"
    aria-labelledby="about-title"
  >
    <div class="about-copy">
      <p class="eyebrow">03 / DETRÁS DEL CÓDIGO</p>
      <h2 id="about-title">
        Sobre mí.
        <br />
        <span>Formación y forma de trabajar.</span>
      </h2>
      <p>
        Soy <strong>Abner Tovar</strong>, ingeniero en Sistemas Computacionales
        por la Universidad de Montemorelos. Vivo en Montemorelos, Nuevo León, y
        busco colaborar de forma remota en un equipo frontend.
      </p>
      <p>
        También he coordinado proyectos residenciales. Esa experiencia
        complementa mi trabajo en la web: planifico entregas, aclaro necesidades
        y mantengo comunicación con quienes participan en el proyecto.
      </p>
      <div class="about-facts">
        <span>
          Español <b>Nativo</b>
        </span>
        <span>
          Inglés <b>B1</b>
        </span>
        <span>
          Disponibilidad <b>Remoto · Tiempo completo</b>
        </span>
      </div>
      <a class="text-link" href={profile.cv} download>
        Descargar CV completo <span aria-hidden="true">↗</span>
      </a>
    </div>
    <aside class="perspective-card" aria-labelledby="perspective-title">
      <div class="perspective-top">
        <span class="eyebrow">EXPERIENCIA COMPLEMENTARIA</span>
        <span aria-hidden="true">✳</span>
      </div>
      <h3 id="perspective-title">
        Planear. Coordinar.
        <br />
        <em>Entregar.</em>
      </h3>
      <p class="perspective-intro">Coordinación de proyectos residenciales.</p>
      <div class="additional-job">
        <span>FEB 2026 — ACTUALIDAD</span>
        <h4>Supervisor de obra residencial</h4>
        <p>Proyecto privado · Montemorelos, México</p>
        <p>
          Coordino trabajos y avances de una ampliación residencial y doy
          seguimiento a planos y definiciones con la dirección arquitectónica.
        </p>
      </div>
      <div class="additional-job">
        <span>JUL 2019 — DIC 2021</span>
        <h4>Gerente de proyectos</h4>
        <p>DFW Corp · Dallas, Texas</p>
        <p>
          Dirigí proyectos residenciales desde la planeación y presupuestación
          hasta la entrega, coordinando equipos y comunicación con clientes y
          especialistas.
        </p>
      </div>
    </aside>
  </section>

  <section class="shell section skills-section" aria-labelledby="skills-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / TECNOLOGÍAS</p>
        <h2 id="skills-title">
          Tecnologías para <span>desarrollar y entregar.</span>
        </h2>
      </div>
      <p>
        Las tecnologías que uso
        <br />a lo largo de una solución.
      </p>
    </div>
    <div class="skills-grid">
      {skills.map((group, i) => (
        <article>
          <span class="skill-number">
            0{i + 1} <span aria-hidden="true">↗</span>
          </span>
          <h3>{group.title}</h3>
          <p>{group.detail}</p>
          <ul class="tags">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section
    id="contacto"
    class="shell contact-section"
    aria-labelledby="contact-title"
  >
    <div class="contact-top">
      <p class="eyebrow">05 / LA SIGUIENTE CONVERSACIÓN</p>
      <span aria-hidden="true">↗</span>
    </div>
    <p>¿Buscas un desarrollador frontend para tu equipo o proyecto?</p>
    <h2 id="contact-title">
      Hablemos de <em>tu proyecto.</em>
    </h2>
    <div class="contact-bottom">
      <a class="contact-email" href={`mailto:${profile.email}`}>
        {profile.email} <span aria-hidden="true">↗</span>
      </a>
      <div>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={profile.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
